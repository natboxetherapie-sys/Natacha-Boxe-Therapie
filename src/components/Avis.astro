 ---
interface Avis {
  texte: string;
  auteur: string;
  etoiles?: number;
}

interface Props {
  titre?: string;
  avis?: Avis[];
  lienTous?: string;
}

const {
  titre = "Ils m'ont fait confiance",
  lienTous = "#",
  avis = []
} = Astro.props;
---

<section class="avis">
  <h2>{titre}</h2>
  <div class="avis-list">
    {avis.map((a) => (
      <div class="avis-item">
        <div class="stars">{"★".repeat(a.etoiles ?? 5)}</div>
        <p>{a.texte}</p>
        <span>— {a.auteur}</span>
      </div>
    ))}
  </div>
  <p class="avis-source">
    Avis issus de Google —
    <a href={lienTous} target="_blank" rel="noopener">
      👉<strong>Voir tous les avis</strong>
    </a>
  </p>
</section>


    <style>
.avis {
  max-width: 900px;
  margin: 80px auto;
  text-align: center;
  background-color: var(--color-sauge);
  color: var(--color-gris-fonce);
  border-radius: 10px;
}
.avis-list {
  display: flex;
  gap: 32px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 32px;
}

.avis-item {
  max-width: 260px;
  font-style: italic;
}

.avis-item span {
  display: block;
  margin-top: 10px;
  font-weight: 600;
}
.stars {
  color: #f5b301;
  font-size: 1.1rem;
  margin-bottom: 8px;
}
.avis-source {
  margin-top: 32px;
  font-size: 0.9rem;
  opacity: 0.8;
}

.avis-source a {
  opacity: 1;
  color: #000;
  font-weight: 500;
}
@media (max-width: 700px) {
  .avis-source {
    padding: 0 2rem;
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .avis-source a {
    display: inline-block;
    word-break: keep-all;
  }
}
    </style>