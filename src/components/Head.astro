---
// src/components/Head.astro
const {
  title = "Natacha Boxe Thérapie - Paimboeuf",
  description = "Description à remplir...",
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://www.natacha-boxe-therapie.fr/images/og-image.webp",
  canonical = "https://www.natacha-boxe-therapie.fr/",
  schema = null
} = Astro.props;

const businessData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Natacha Boxe Thérapie",
  "image": ogImage,
  "@id": "https://www.natacha-boxe-therapie.fr/#business",
  "url": "https://www.natacha-boxe-therapie.fr/",
  "telephone": "06XXXXXXXX",
  "email": "natacha@exemple.fr",
  "sameAs": [],
  "areaServed": "Paimboeuf, Saint-Nazaire, ...",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "ton adresse",
    "addressLocality": "Paimboeuf",
    "postalCode": "44560",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 0.0,
    "longitude": 0.0
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
    "opens": "09:00",
    "closes": "19:00"
  }
};
---

<!-- Base -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />

<!-- Open Graph -->
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />

<!-- Favicons -->
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#ta-couleur" />

<!-- JSON-LD LocalBusiness -->
<script type="application/ld+json" set:html={JSON.stringify(businessData)} />

<!-- JSON-LD spécifique à la page (optionnel) -->
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
