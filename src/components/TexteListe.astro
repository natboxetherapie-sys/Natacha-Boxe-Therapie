---
interface Props {
  titre?: string;
  texte?: string;
  liste?: string[];
  texteSuite?: string;
}

const {
  titre = "Tarifs à partir de 35€/h",
  texte = "",
  liste = [],
  texteSuite = ""
} = Astro.props;
---

<section class="tarifs">
  <h2>{titre}</h2>
  <p>
    <span set:html={texte} />
    {liste.length > 0 && (
      <ul class="liste-centree">
        {liste.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
    <span set:html={texteSuite} />
  </p>
</section>


    <style>
        .tarifs {
  padding: 2% 10%;
  text-align: center;
  background-color: #ffffff;
  color: #1f2937;
}

.tarifs p {
  text-align: center;
}

.liste-centree {
  max-width: 600px;
  margin: auto;
  text-align: left;
}
    </style>