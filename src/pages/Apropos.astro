---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilAriane from '../components/FilAriane.astro';
import H1etTexte from '../components/H1etTexte.astro';
import Formulaire from '../components/Formulaire.astro';
import { siteConfig } from '../config/site.ts';
import Presse from '../Presse.astro';


const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "url": `${siteConfig.url}/contact`
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteConfig.url },
      { "@type": "ListItem", "position": 2, "name": "Contact", "item": `${siteConfig.url}/contact` }
    ]
  }
]
---

<BaseLayout
  title={`Contacter ${siteConfig.name}`}
  description="Contactez-nous pour plus d'informations..."
  canonical={`${siteConfig.url}/contact`}
  ogTitle={`Contacter ${siteConfig.name}`}
  ogDescription="Contactez-nous pour plus d'informations..."
  schema={schema}
>
  <FilAriane items={[
    { label: "Accueil", href: "/" },
    { label: "Contact" }
  ]} />
  <H1etTexte
    titre="Contactez Natacha"
    texte="Une question sur la <strong>boxe thérapie</strong> ? Écrivez-moi !"
  />
  <Formulaire
    action="/traitement-contact"
    placeholderMessage="Bonjour ! Décrivez ici votre demande..."
  />
    <Presse
  titre="La presse en parle !"
  articles={[
    {
      image: "/public/presse1.jpeg",
      imageAlt: "Article des Infos du Pays de Redon sur CJAL",
      imageWidth: 220,
      imageHeight: 510,
      titre: "Les Infos du Pays de Redon",
      date: "16/04/2025"
    },
    {
      image: "/public/presse2.jpeg",
      imageAlt: "Article de Presse Océan sur CJAL",
      imageWidth: 450,
      imageHeight: 521,
      titre: "Presse Océan",
      date: "02/04/2025"
    },
    {
      image: "/public/presse3.jpeg",
      imageAlt: "Article des Infos du Pays de Redon sur CJAL",
      imageWidth: 450,
      imageHeight: 629,
      titre: "Les Infos du Pays de Redon",
      date: "18/03/2026"
    },
    {
      image: "/public/presse4.jpeg",
      imageAlt: "Article des Infos du Pays de Redon sur CJAL",
      imageWidth: 450,
      imageHeight: 629,
      titre: "Les Infos du Pays de Redon",
      date: "18/03/2026"
    }
  ]}
/>

</BaseLayout>