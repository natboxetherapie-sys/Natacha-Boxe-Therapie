---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Erreur 404"
  description="La page demandée est introuvable sur le site Natacha Boxe Thérapie."
>
  <section class="error-404">
    <div class="container">
      <p class="surtitle">Erreur 404</p>
      <h1>Reprenons le fil</h1>

      <p class="intro">
        La page que vous cherchez n’est plus disponible, ou a changé de place.
      </p>
      <p class="intro">
        Vous pouvez revenir vers un espace plus clair depuis les liens ci-dessous.
      </p>

      <div class="illustration-404" aria-hidden="true">
        <svg viewBox="0 0 320 140" xmlns="http://www.w3.org/2000/svg" fill="none">
          <path
            d="M20 85C45 55 78 40 110 52C135 61 145 88 127 103C106 120 76 111 74 88C72 64 101 34 150 32C204 30 236 62 232 93C228 121 194 128 176 113C159 99 162 74 186 66C214 57 254 68 300 92"
            pathLength="1"
          />
          <circle cx="74" cy="88" r="4" />
          <circle cx="300" cy="92" r="4" />
        </svg>
      </div>

      <nav class="actions" aria-label="Liens utiles">
        <a class="btn-primary" href={`${import.meta.env.BASE_URL}`}>Retour à l’accueil</a>
        <a class="btn-secondary" href={`${import.meta.env.BASE_URL}boxe-therapie`}>Découvrir la boxe thérapie</a>
        <a class="btn-secondary" href={`${import.meta.env.BASE_URL}contact`}>Prendre contact</a>
      </nav>

      <div class="apaisement" data-aos="fade-up">
        <p>
          Un lien a peut-être été modifié. L’essentiel est que vous soyez au bon endroit pour continuer.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-404 {
    background-color: var(--color-blanc-lin);
    color: var(--color-gris-fonce);
    width: 100%;
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .container {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 5%, 3rem);
    text-align: center;
  }

  .surtitle {
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  .intro {
    max-width: 38rem;
    margin: 0 auto 1rem;
    line-height: 1.7;
  }

  .illustration-404 {
    width: min(320px, 72%);
    margin: 2rem auto 2rem;
    color: oklch(0.45 0.03 70 / 0.78);
    opacity: 0.95;
  }

  .illustration-404 svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .illustration-404 path {
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .illustration-404 circle {
    fill: currentColor;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .actions a {
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .actions a:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.9rem 1.3rem;
    border-radius: 999px;
  }

  .btn-primary {
    background: var(--color-gris-fonce);
    color: var(--color-blanc-lin);
  }

  .btn-secondary {
    border: 1px solid oklch(0 0 0 / 0.12);
    color: var(--color-gris-fonce);
    background: transparent;
  }

  .apaisement {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid oklch(0 0 0 / 0.10);
  }

  .apaisement p {
    max-width: 34rem;
    margin: 0 auto;
    line-height: 1.7;
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .illustration-404 path {
      animation: drawLine 1.8s ease-out both;
    }

    .illustration-404 circle:first-of-type {
      animation: pointAppear 0.4s ease-out 0.9s both;
    }

    .illustration-404 circle:last-of-type {
      animation: pointAppear 0.4s ease-out 1.35s both;
    }
  }

  @keyframes drawLine {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pointAppear {
    from {
      opacity: 0;
      transform: scale(0.6);
      transform-origin: center;
    }
    to {
      opacity: 1;
      transform: scale(1);
      transform-origin: center;
    }
  }

  @media (max-width: 700px) {
    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
    }

    .illustration-404 {
      width: min(280px, 82%);
    }
  }
</style>