---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HeroLeft from '../components/HeroLeft.astro';
import BlocTexteImage from '../components/BlocTexteImage.astro';
import Etapes from '../components/Etapes.astro';
import BlocTexte from '../components/BlocTexte.astro';
import Avis from '../components/Avis.astro';
import Slider from '../components/Slider.astro';
import QuestionsFrequentes from '../components/QuestionsFrequentes.astro';
import Action from '../components/Action.astro';

import { siteConfig } from '../config/site';


import monImage from '../images/natacha1.webp';
import maPhoto from '../images/atelier4.webp';
import tonImage from '../images/atelier11.webp';


import natacha3 from '../images/natacha3.webp';
import natacha4 from '../images/natacha4.webp';
import natacha6 from '../images/natacha6.webp';
import natacha8 from '../images/natacha8.webp';
import atelier from '../images/atelier.webp';
import atelier2 from '../images/atelier2.webp';
import atelier3 from '../images/atelier3.webp';
import atelier5 from '../images/atelier5.webp';
import atelier6 from '../images/atelier6.webp';
import atelier7 from '../images/atelier7.webp';
import atelier9 from '../images/atelier9.webp';
import atelier10 from '../images/atelier10.webp';
import atelier8 from '../images/atelier8.webp';




const realisations = [
  { src: natacha3.src, alt: "Natacha Jarry, boxe thérapeute à Saumur", width: 500, height: 333 },
  { src: natacha4.src, alt: "Natacha seule en train de boxer", width: 500, height: 333 },
  { src: natacha6.src, alt: "moment de sororité Natacha boxe thérapie", width: 600, height: 399 },
  { src: natacha8.src, alt: "Natacha boxe et miroir", width: 900, height: 600 },
  { src: atelier.src, alt: "atelier de boxe thérapie à Saumur", width: 450, height: 600 },
  { src: atelier2.src, alt: "photo d'un atelier de boxe thérapie à Saumur", width: 350, height: 487 },
  { src: atelier3.src, alt: "image d'une séance boxe thérapie avec Natacha", width: 450, height: 600 },
  { src: atelier5.src, alt: "une enfant lors d'un atelier de boxe thérapie à Saumur", width:350, height: 466 },
  { src: atelier6.src, alt: "Natacha et une élève en boxe thérapie à Saumur", width:518, height: 600 },
  { src: atelier7.src, alt: "atelier collectif de boxe thérapie à Saumur", width:399, height: 600 },
  { src: atelier8.src, alt: "atelier avec Natacha boxe thérapie à Saumur", width:399, height: 600 },
  { src: atelier9.src, alt: "Natacha boxe thérapie à Saumur", width:600, height: 692 },
  { src: atelier10.src, alt: "séance avec Natacha de boxe thérapie à Saumur", width:600, height: 900 },
];

const mesEtapes = [
  { titre: "On se rencontre", texte: "Un premier échange pour discuter de tes besoins, de ton profil et de tes objectifs. C'est là que tout commence." },
  { titre: "Je construis ta séance", texte: "Je prépare un programme sur-mesure, adapté à tes besoins et à ce que tu traverses, que tu viennes seul(e), en groupe ou en équipe." },
  { titre: "On se lance", texte: "Une séance qui allie mouvement et écoute. Un espace pour lâcher prise et se reconnecter à soi." },
  { titre: "On fait le point", texte: "Après chaque séance, on échange sur les ressentis. J'ajuste si besoin, pour que tu avances pas à pas, vers tes objectifs." },

];
---

<BaseLayout
  title={`${siteConfig.name} - ${siteConfig.tagline}`}
  description={siteConfig.description}
  canonical={siteConfig.url}
  ogTitle={`${siteConfig.name} - ${siteConfig.tagline}`}
  ogDescription={siteConfig.description}
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Natacha Boxe Thérapie",
      "url": "https://natacha-boxetherapie.fr",
      "telephone": "+33684556902",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Saumur",
        "addressRegion": "Pays de la Loire",
        "addressCountry": "FR"
      },
      "description": siteConfig.description,
      "areaServed": "Saumur et rayon de 20km"
    }
  ]}
>

  <Hero
    titre="Natacha<br>Boxe-Thérapie<br>Saumur"
    texte="<p><strong>Libérer, Renforcer, Transformer</strong></p>
            <em>Corps, coeur et mental en harmonie</em>
          <p><strong>Boxe thérapeute</strong> certifiée à Saumur et dans un rayon de 20km.</p>

<p>Tu ressens le besoin de te retrouver, de respirer et d'avancer ?</p>
<p>La <strong>boxe thérapie</strong>, c’est un espace bienveillant, sans jugement ni compétition, où le mouvement libère ce que les mots ne réussissent pas à dire.</p>

Pour les enfants, les ados, les adultes, quel que soit ton point de départ.
"
    image={monImage}
    imageAlt="Natacha Boxe Thérapie Saumur"
    lienLabel="Je prends contact"
    lienHref={`${import.meta.env.BASE_URL}contact`}
  />

  <HeroLeft
  titre="La boxe thérapie, c’est quoi ?"
  texte={`
    <p>Non, on ne vient pas ici pour se battre.</p>

    <p>La <strong>boxe thérapie</strong>, c’est utiliser le mouvement, le souffle et l'énergie du corps comme un outil pour libérer ce qu’on porte à l’intérieur : les tensions, les émotions enfouies, le stress accumulé.</p>

    <p>Tout ce qui tourne en boucle et qu’on n’arrive pas à évacuer.</p>

    <p>Le principe est simple : <strong>le corps et les émotions</strong> sont profondément liés. Quand le corps se dénoue, quelque chose se libère aussi à l’intérieur. On repart plus léger, plus ancré, plus aligné avec soi-même.</p>

    <p>Ici, il ne s'agit pas de performance. Ce n’est pas de la compétition. Ce n’est pas réservé aux sportifs. C’est un <strong>espace pour souffler, lâcher prise et se reconnecter à soi</strong>, à ses propres besoins, dans un <strong>cadre bienveillant et sécurisé</strong>.</p>

    <h3>Les bienfaits de la boxe thérapie</h3>
    <ul>
      <li>Évacuer le stress et les émotions bloquées</li>
      <li>Reprendre confiance en son corps et en soi</li>
     <li>Lâcher prise sans pression ni jugement</li>
      <li>Se reconnecter à ses ressentis</li>
      <li>Retrouver de l’énergie et de la vitalité</li>
    </ul>
  `}
  image={tonImage}
  imageAlt="Séance de boxe thérapie"
/>
  
  
<BlocTexteImage
    titre="À qui s'adressent mes séances ?"
    texte="<h3>Les enfants et les adolescents</h3>
        <p>Un espace bienveillant pour <strong>exprimer ses émotions et reprendre confiance</strong>.<br>
        La <strong>boxe thérapie</strong> est une activité accessible à tous les jeunes, quel que soit leur niveau sportif ou leur rapport au mouvement. <br>
        Chaque séance individuelle est pensée pour <strong>avancer à son rythme</strong>, sans compétition ni pression.<br> J'accompagne les enfants et les adolescents à <strong>Saumur et alentours</strong>, en adaptant chaque séance à leur profil.</p>

        <h3>Les femmes et les hommes en quête de mieux-être</h3>
        <p>Pour <strong>retrouver de l'énergie, lâcher prise et se reconnecter avec soi-même</strong>.<br>
        Après une période difficile ( maladie chronique, burn-out, séparation, deuil...) ou simplement quand on a <strong>besoin de souffler</strong>, la <strong>boxe thérapie</strong> offre un espace doux et dynamisant pour évacuer les <strong>émotions</strong> accumulées et retrouver de l'élan.<br>
         Je te propose un <strong>accompagnement adapté</strong> à ton état physique et émotionnel, à ton propre tempo.</p>"

     
  
    image={maPhoto}
    imageAlt="Natacha Boxe Thérapie Saumur"
   
  />


<BlocTexteImage
    
     texte="<h3> Les entreprises et les équipes</h3>
      <p>Pour un <strong>team building</strong> qui crée un vrai lien.<br>
      J'interviens auprès des <strong>entreprises</strong> et des équipes avec des <strong>ateliers sur mesure</strong> qui travaillent en profondeur la cohésion, la confiance et la <strong>gestion des émotions</strong>.<br> Accessible à tous, aucun niveau sportif requis.<br>
       Une activité originale et mémorable, à <strong>Saumur et dans un rayon de 20 km</strong>, pour que la bonne énergie du jour J se prolonge bien au-delà.</p>

      <h3>Les enfants à besoins spécifiques</h3>
      <p>Une activité <strong>adaptée à tous</strong>.<br>
      Je travaille au quotidien avec des <strong>jeunes en situation de handicap</strong>. Je connais les TSA et le handicap dans sa diversité, je comprends les <strong>besoins spécifiques</strong>. J'adapte chaque séance en conséquence.<br> Un cadre stable, des rituels clairs, et une approche pensée pour que chaque enfant puisse avancer sereinement, à sa façon.</p>
"
  
    lienLabel="En savoir plus"
    lienHref={`${import.meta.env.BASE_URL}apropos`}
  />


<Etapes
  titre="Comment se déroule une séance ?"
  intro="Chaque accompagnement commence par un échange téléphonique pour se mettre d’accord sur <strong>tes besoins et tes attentes</strong>.<br> 
    Je fournis tout le matériel, il n'y a rien à prévoir de ton côté.<br>
    Les séances se déroulent à domicile, en extérieur ou directement dans vos locaux."

  etapes={mesEtapes}
  
/>


  <Avis
    titre="Ils m'ont fait confiance"
    lienTous="https://share.google/MIFRXhOpA1wNrpwJp" 
    avis={[
      { texte: "Ces séances m'ont permis d'améliorer ma condition physique, renforcer mon cardio et augmenter ma confiance et l' estime de soi. De plus, j'éprouve un bien être, un équilibre psychique. Ces séances en groupe nous apportent des moments de partage et de soutien, le tout soupoudré de légèreté, de rires et d' entraide.", auteur: "Stéfany"},
      { texte: "Praticante de la boxe thérapie en collectivité et en individuel, c'est une libération émotionnelle profonde et un épanouissement personnel. Prise de confiance, dépassement de soi, introspection assurée", auteur: "Marine" },
      { texte: "Des cours de boxe thérapie qui font un bien fou, autant au corps qu’au mental. On ressort boostée, plus confiante et pleine d’énergie. Natacha est incroyable : son énergie est communicative et elle sait vraiment nous embarquer. Il y a une vraie sororité dans le groupe, beaucoup de bienveillance et aucun jugement. Un moment pour soi qui fait vraiment la différence !", auteur: "Coralie"},
      { texte: "Une rencontre au moment où j'en avais vraiment besoin. Les séances font vraiment du bien! On en redemande même en dehors des créneaux de la MJC.", auteur: "Bénédicte"},
      { texte: "Grâce à Natacha, j’ai récupéré beaucoup de confiance en moi, je fais maintenant des choses que je n’osais pas avant. J’ai adoré les discussions avec elle pendant les cours.", auteur: "Sarah" },
      { texte: "L’approche de Natacha m’a permis de reprendre contact avec mes possibles, de pointer ce qui était encore à travailler. Nous sommes, toutes les femmes, une grande communauté qui doit s’entraider et Natacha est une d’entre nous qui a décidé d’aider les autres.", auteur: "China" },
      { texte: "Dans nos vies de femmes, on nous fait toujours sentir qu’on est un petit peu nulle et donc la boxe ça faisait des années que ça me tentait mais une fois de plus j’avais peur d’être nulle. Quand je suis tombée sur la carte de Natacha je me suis dit il faut tenter et c’est une des meilleures choses que j’ai faite. La bienveillance, l’écoute et les bons conseils de Natacha ainsi que les pattes d’ours 🤣 ont fait que je ne suis pas prête d’oublier cette première séance. Après les séances individuelles je me suis inscrite à la MJC et toutes les semaines je fais une séance en groupe. Avec des filles super 👍 Cette activité me permet de me sentir plus solide, plus belle et alors plus du tout nulle ❤️. ", auteur: "Céline"  }

    ]}
  />


  <BlocTexte 
       titre="Mes tarifs"
  description=" <h3>Séance individuelle : 50 €</h3>
    
    <p>Un <strong>accompagnement personnalisé</strong> pour <strong>libérer les tensions, te reconnecter à toi-même et avancer selon tes envies.</strong> <br>
    Chaque séance s'adapte à tes besoins, dans le respect de ton corps, de tes émotions et de ton histoire.</p>
    <h3>Ateliers collectifs, associations et entreprises</h3>
    <strong>Tarif sur devis</strong>
    <p>J'interviens auprès de différents publics — adolescents, adultes, structures médico-sociales, entreprises — avec des <strong>séances adaptées</strong> aux objectifs et aux besoins de chacun. </p>
"
  boutonTexte="Parlons de ton projet"
  boutonLien={`${import.meta.env.BASE_URL}contact`}
  
/>


  <Slider
    slides={realisations}
    title="Séances de boxe thérapie"
    subtitle="Et chaque mouvement devient une introspection. On vient déposer ses blessures, traverser ses émotions et repartir plus aligné, plus fort, plus vivant."
    instagramUrl="https://www.instagram.com/natacha.boxetherapie"
  />
    
  <QuestionsFrequentes
    questions={[
      { question: "C'est quoi la boxe thérapie ?", reponse: "La boxe thérapie, ce n'est pas de la compétition ni du sport intensif. C'est une approche qui utilise les gestes de la boxe (les frappes, le souffle, le mouvement) comme un outil pour libérer les émotions, évacuer le stress et se reconnecter à soi. Le corps et les émotions sont profondément liés : quand le corps se dénoue, quelque chose se libère aussi à l'intérieur." },
      { question: "Comment se passe une séance de boxe thérapie ?", reponse: "Chaque séance est unique et adaptée à qui vous êtes. Elle combine des exercices de boxe, de la respiration, des moments d'écoute et de reconnexion à vos ressentis. Pas de niveau requis, pas de jugement. On avance à votre rythme, dans un cadre bienveillant et sécurisé." },
      { question: "La boxe thérapie est-elle efficace ?", reponse: "Oui, à condition d'y venir avec l'envie de s'écouter. Beaucoup de participants repartent plus légers, plus ancrés, avec davantage d'énergie. Les bienfaits les plus souvent ressentis : réduction du stress, regain de confiance, meilleure gestion des émotions et reconnexion à son corps." },
      { question: "La boxe thérapie, c'est pour qui ?", reponse: "Pour tout le monde ! Les enfants, les adolescents, les adultes, les personnes en situation de handicap. Que vous soyez sportif ou non, que vous traversiez une période difficile ou que vous cherchiez simplement à prendre soin de vous... Il n'y a pas de profil type. Chaque séance est adaptée à votre situation." },
      { question: "Comment fonctionne la boxe thérapie pour le bien-être ?", reponse: "Le principe repose sur le lien entre le corps et les émotions. En mobilisant le corps à travers les gestes de la boxe, on libère les tensions physiques et émotionnelles accumulées. Le mouvement permet d'évacuer ce que les mots ne réussissent pas toujours à exprimer : stress, colère, tristesse, épuisement etc." },
      { question: "Quels sont les tarifs de la boxe thérapie ?", reponse: "Les tarifs varient selon le format choisi (séance individuelle, atelier collectif, intervention en entreprise) et la durée. Contactez-moi pour un premier échange gratuit. Je vous propose ensuite une formule adaptée à vos besoins." }
    ]}
  />
  <Action 
      titre = "Le premier coup, c'est toi qui le donnes !"
      texte = "Tu veux en savoir plus ?"
      lienLabel = "Je prends contact"
      lienHref = {`${import.meta.env.BASE_URL}contact`}
  />


</BaseLayout>